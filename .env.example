# ================================================
# 데이터베이스 설정
# ================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=coverletter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/coverletter

# ================================================
# AI API 키
# ================================================

# OpenAI (필수)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-large

# Anthropic (Claude, 선택)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Tavily (웹 검색, 선택)
TAVILY_API_KEY=tvly-dev-your-tavily-api-key-here

# Firecrawl (웹 스크래핑, 선택)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here

# ================================================
# AI 모델 설정
# ================================================
GPT_MODEL=gpt-4o
GPT_MINI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-20250514

# ================================================
# 검색 및 스크래핑 설정
# ================================================
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced
SCRAPE_MAX_CHARS=5000
SCRAPE_TIMEOUT=30

# ================================================
# 카카오 OAuth (선택 - 개발 시에는 기본값 사용)
# ================================================
# 카카오 개발자 콘솔: https://developers.kakao.com
# 1. 애플리케이션 추가
# 2. REST API 키 복사 → KAKAO_CLIENT_ID
# 3. 보안 > Client Secret 생성 → KAKAO_CLIENT_SECRET
# 4. 플랫폼 > Web > Redirect URI 등록: http://localhost:8000/api/v1/auth/kakao/callback

KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback

# ================================================
# JWT 인증
# ================================================
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
